# Checking Outliars
num_features = df.select_dtypes(include='number')  #int64 or float64
Q1 = num_features.quantile(0.25)
Q3 = num_features.quantile(0.75)
IQR = Q3 - Q1

lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

outliers = (num_features < lower_bound) | (num_features > upper_bound)
print(outliers.sum())


# Data Clening
   # - Ther's is 1 (-ve) no. in the Physical_Activity_Hours, so :-

# 1. To drop duplicates
df = df.drop_duplicates()

# make that -ve no. to zero (0) by 'clip'

# 2. Converting -ve or unrealistic value to realistic value
df['Physical_Activity_Hours'] = df['Physical_Activity_Hours'].clip(lower=0)


df.describe()


# Skewness
  # - It's a focus on where our date is : right or left or center or else ?

num_cols = df.select_dtypes(include='number')
num_cols.skew()


# if the value comes near of 'zero (0)'     :- Centralized
# if the value comes in (-ve) / less than 0 :- Left Skewed
# if the value comes in (+ve) / more than 0 :- Right Skewed

# & to fix that above 3 by 'Log Transformation'





top_countries = df['Country'].value_counts().index[:10].tolist()


def group_countries(country):
    if country in top_countries: 
        return country
    else:
        return 'Other'


df['Grouped_country'] = df['Country'].apply(group_countries)
df['Grouped_country'].value_counts()









